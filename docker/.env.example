# ---------------------------------------------------------------------------
# MqttRelay — environment configuration.
#
# Copy this file to `.env` and fill in the real values:
#   cp .env.example .env
#
# docker/docker-compose.yml injects these variables into the container, and the
# entrypoint uses them to generate /app/config.toml on first start (when it is
# missing). The same variables can also be used to run the app outside Docker.
# ---------------------------------------------------------------------------

# ---- Flask web dashboard ------------------------------------------------
APP_PROD=true
APP_HOST=0.0.0.0
APP_PORT=23909
APP_THREADED=true
APP_DEBUG=false
# Logging level for the Flask application logger — DEBUG, INFO, WARNING,
# ERROR or CRITICAL. Controls the log lines added to the blueprint routes
# (current_app.logger / mqtt.app.logger).
APP_LOG_LEVEL=DEBUG
APP_SSL=false
APP_SSL_KEY=resources/key.pem
APP_SSL_CERT=resources/cert.pem
APP_SSL_ENCAPSULATED=false
APP_SECRET_KEY=
DEFAULT_LANGUAGE=fr

# ---- MQTT broker --------------------------------------------------------
MQTT_BROKER_URL=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_TLS_ENABLED=false

# ---- PostgreSQL database -------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mqttrelay
DB_USER=mqttrelay
DB_PASSWORD=

# ---- Reversible encryption master key (required when key_source = "env") --
# 32-byte key, base64- or hex-encoded.
MQTT_RELAY_ENC_KEY_PRIMARY=

# ---- docker-compose ------------------------------------------------------
# Host port published by the `web` service.
MQTTRELAY_PORT=23909
# Overrides for the optional local `postgres` service in docker-compose.dev.yml.
POSTGRES_DATABASE=mqttrelay
POSTGRES_USER=mqttrelay
POSTGRES_PASSWORD=mqttrelay
POSTGRES_PORT=5432
